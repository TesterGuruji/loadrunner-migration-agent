          <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="05_Checkout" enabled="true">
            <boolProp name="TransactionController.parent">true</boolProp>
            <boolProp name="TransactionController.includeTimers">false</boolProp>
          </TransactionController>
          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="checkout">
              <stringProp name="HTTPSampler.path">/api/checkout</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
              <stringProp name="HTTPSampler.method">POST</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                <collectionProp name="Arguments.arguments">
                  <elementProp name="" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.value">{&quot;cartId&quot;:&quot;${cCartId}&quot;}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                  </elementProp>
                </collectionProp>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree>
              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="EncType=application/json" enabled="true">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Content-Type</stringProp>
                    <stringProp name="Header.value">application/json</stringProp>
                  </elementProp>
                </collectionProp>
              </HeaderManager>
              <hashTree/>
              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="web_add_header: X-Order-Ref" enabled="true">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">X-Order-Ref</stringProp>
                    <stringProp name="Header.value">${cOrderRef}</stringProp>
                  </elementProp>
                </collectionProp>
              </HeaderManager>
              <hashTree/>
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="build_order_ref" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">/* Original LoadRunner C code (Action.c:12):
char *build_order_ref(char *user, int iteration)
{
	static char ref[64];
	sprintf(ref, &quot;TGJ-%s-%04d&quot;, user, iteration % 10000);
	return ref;
}
   and Action.c:80-83:
	static int iteration = 0;  iteration++;
	lr_save_string(build_order_ref(lr_eval_string(&quot;{pUser}&quot;), iteration), &quot;cOrderRef&quot;);
	web_add_header(&quot;X-Order-Ref&quot;, &quot;{cOrderRef}&quot;);
*/
// &quot;static int iteration&quot; keeps its value per user across iterations -&gt; thread-scoped JMeter variable.
int iteration = (vars.get(&apos;tgjIteration&apos;) ?: &apos;0&apos;) as int
iteration++
vars.put(&apos;tgjIteration&apos;, String.valueOf(iteration))
vars.put(&apos;cOrderRef&apos;, String.format(&apos;TGJ-%s-%04d&apos;, vars.get(&apos;pUser&apos;), iteration % 10000))
</stringProp>
              </JSR223PreProcessor>
              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="SaveCount=confirmCount / LR_PASS-LR_FAIL" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">/* Original LoadRunner logic (Action.c:88, 99-104):
   web_reg_find(&quot;Text=\&quot;status\&quot;:\&quot;CONFIRMED\&quot;&quot;, &quot;SaveCount=confirmCount&quot;, LAST);
   if (atoi(lr_eval_string(&quot;{confirmCount}&quot;)) &gt; 0) lr_end_transaction(&quot;05_Checkout&quot;, LR_PASS);
   else { lr_error_message(&quot;Checkout not confirmed for cart %s&quot;, ...); lr_end_transaction(&quot;05_Checkout&quot;, LR_FAIL); }
*/
def body = prev.getResponseDataAsString()
def needle = &apos;&quot;status&quot;:&quot;CONFIRMED&quot;&apos;
int confirmCount = body.split(java.util.regex.Pattern.quote(needle), -1).length - 1
vars.put(&apos;confirmCount&apos;, String.valueOf(confirmCount))
if (confirmCount &gt; 0) {
    AssertionResult.setFailure(false)
} else {
    log.error(&apos;Checkout not confirmed for cart &apos; + vars.get(&apos;cCartId&apos;))
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&apos;Checkout not confirmed for cart &apos; + vars.get(&apos;cCartId&apos;))
}
</stringProp>
              </JSR223Assertion>
              <hashTree/>
            </hashTree>
          </hashTree>

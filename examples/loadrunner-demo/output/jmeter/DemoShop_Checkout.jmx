              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Pick random search row" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">// pSearch / pProductId: users.dat, GenerateNewVal=EachIteration, SelectNextRow=Random,
// &quot;Same line as pSearch&quot; -&gt; one random row per iteration, both values from the same line.
import org.apache.jmeter.services.FileServer

def key = &apos;tgj.search.rows&apos;
def rows = props.get(key)
if (rows == null) {
    synchronized (props) {
        rows = props.get(key)
        if (rows == null) {
            def dir = props.getProperty(&apos;dataDir&apos;, &apos;testdata&apos;)
            def f = new File(dir)
            if (!f.isAbsolute()) { f = new File(FileServer.getFileServer().getBaseDir(), dir) }
            def lines = new File(f, &apos;search.csv&apos;).readLines(&apos;UTF-8&apos;)
            rows = lines.drop(1).findAll { it.trim() }.collect { it.split(&apos;,&apos;) as List }
            props.put(key, rows)
        }
    }
}
def row = rows[new Random().nextInt(rows.size())]
vars.put(&apos;pSearch&apos;, row[0].trim())
vars.put(&apos;pProductId&apos;, row[1].trim())
// Pacing: remember when this iteration started (ConstPace is measured from iteration start).
vars.put(&apos;iterStart&apos;, String.valueOf(System.currentTimeMillis()))
</stringProp>
              </JSR223PreProcessor>
